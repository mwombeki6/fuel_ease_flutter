{
  "version": 8,
  "name": "FuelEase Night",
  "metadata": {
    "mapbox:autocompose": false,
    "mapbox:sdk-support": { "android": "11.0.0", "ios": "11.0.0", "js": "3.0.0" },
    "mapbox:uiParadigm": "components"
  },
  "center": [39.2083, -6.7924],
  "zoom": 12,
  "bearing": 0,
  "pitch": 0,
  "sources": {
    "composite": {
      "url": "mapbox://mapbox.mapbox-streets-v8,mapbox.mapbox-terrain-v2",
      "type": "vector"
    }
  },
  "sprite": "mapbox://sprites/mapbox/navigation-night-v1/v3",
  "glyphs": "mapbox://fonts/mapbox/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#060914" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "composite",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match", ["get", "class"],
          "wood", "#0A1A15",
          "scrub", "#091810",
          "grass", "#091810",
          "crop", "#0A1910",
          "#060914"
        ],
        "fill-opacity": 0.5
      }
    },
    {
      "id": "national-park",
      "type": "fill",
      "source": "composite",
      "source-layer": "landuse_overlay",
      "filter": ["==", ["get", "class"], "national_park"],
      "paint": { "fill-color": "#0A1A10", "fill-opacity": 0.6 }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "composite",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match", ["get", "class"],
          "park", "#0A1A15",
          "airport", "#0D1525",
          "facility", "#0D1B2A",
          "industrial", "#0C1728",
          "school", "#0D1930",
          "residential", "#080F1F",
          "#070C1C"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "water-shadow",
      "type": "fill",
      "source": "composite",
      "source-layer": "water",
      "paint": {
        "fill-color": "#041020",
        "fill-translate": [0, 2],
        "fill-opacity": 0.5
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "composite",
      "source-layer": "water",
      "paint": { "fill-color": "#08172E" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "composite",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#0A1D38",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 2]
      }
    },
    {
      "id": "aeroway-polygon",
      "type": "fill",
      "source": "composite",
